# Copy to .env (git-ignored) and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path to the repo the assistant is allowed to read.
# Windows example: C:\Source\repos\my-angular-app
REPO_PATH=

# Optional: override the model (check the current model IDs in the Claude Console).
CLAUDE_MODEL=claude-sonnet-5-5

# --- MCP server (Phase 2) ---
# Set this to have the agent use the MCP server instead of in-process tools.
# Start the server first with: npm run serve
# MCP_SERVER_URL=http://127.0.0.1:3333/mcp

# Server settings (used by npm run serve)
# MCP_PORT=3333
# MCP_HOST=127.0.0.1
# If set, clients must send "Authorization: Bearer <token>". Required for non-local hosts.
# MCP_AUTH_TOKEN=

# --- Pull-request review (Phase 3) ---
# Fine-grained GitHub token: Pull requests (read and write) + Contents (read-only).
# Optional for public PRs; needed for private repos, higher rate limits, and --post.
# GITHUB_TOKEN=
# Register post_review on a standalone server (npm run serve). Requires GITHUB_TOKEN.
# GITHUB_ALLOW_POST=false
# Spend cap per review, in US dollars.
# REVIEW_MAX_BUDGET_USD=1

# --- Web UI (Phase 4) ---
# Port for npm run web.
# WEB_PORT=3334
# Hosting only (set by infra/private.bicep on Azure). Locally, leave these unset.
# WEB_HOST=0.0.0.0                      # bind address; anything but loopback requires ALLOWED_GITHUB_USERS
# PUBLIC_HOSTS=codebase-qa.example.com  # extra host names the server answers to
# ALLOWED_GITHUB_USERS=tpotechno        # GitHub users admitted behind Container Apps sign-in
